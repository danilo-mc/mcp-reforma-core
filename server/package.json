{
  "name": "mcp-reforma-server",
  "version": "0.1.0",
  "description": "Servidor MCP independente para a calculadora oficial da Reforma Tributária do Consumo (CBS/IBS/IS), com recibo verificável.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-reforma": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:golden": "vitest run --project golden",
    "rates:check": "node --experimental-strip-types src/rates/check.ts",
    "rates:check:strict": "node --experimental-strip-types src/rates/check.ts --strict"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "canonicalize": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
